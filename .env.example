# Reference only: Python does not automatically load .env files.
# Export variables in your shell, or use Docker --env-file.
JEWELMENTOR_PROVIDER=demo
JEWELMENTOR_DB=runtime/jewelmentor.db
# For live mode, set provider=openai and supply your own key on the server.
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
JEWELMENTOR_NODE_TIMEOUT=20
JEWELMENTOR_TURN_TIMEOUT=60
